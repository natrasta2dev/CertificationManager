# Chemin de stockage des certificats (défaut: ~/.certmanager)
CERTMANAGER_STORAGE_PATH=

# Serveur web
CERTMANAGER_HOST=127.0.0.1
CERTMANAGER_PORT=8000
CERTMANAGER_DEBUG=false

# Authentification (désactivée par défaut en dev)
CERTMANAGER_AUTH_ENABLED=false
CERTMANAGER_JWT_SECRET=change-me-in-production
CERTMANAGER_JWT_EXPIRE_MINUTES=1440
CERTMANAGER_ADMIN_PASSWORD=

# Sécurité
CERTMANAGER_RATE_LIMIT_ENABLED=true
CERTMANAGER_RATE_LIMIT_PER_MINUTE=120
CERTMANAGER_MAX_UPLOAD_SIZE_MB=10
CERTMANAGER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Chiffrement des clés privées (nécessite CERTMANAGER_STORAGE_PASSWORD)
CERTMANAGER_ENCRYPT_KEYS=false
CERTMANAGER_STORAGE_PASSWORD=

# JWT refresh & audit
CERTMANAGER_JWT_REFRESH_EXPIRE_DAYS=7
CERTMANAGER_AUDIT_RETENTION_DAYS=90

# Notifications SMTP (optionnel)
CERTMANAGER_SMTP_ENABLED=false
CERTMANAGER_SMTP_HOST=
CERTMANAGER_SMTP_PORT=587
CERTMANAGER_SMTP_USER=
CERTMANAGER_SMTP_PASSWORD=
CERTMANAGER_SMTP_TLS=true
CERTMANAGER_SMTP_FROM=
CERTMANAGER_SMTP_TO=
